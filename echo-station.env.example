# Copy to /etc/echo-station.env and fill in (or run install-echo-station-service.sh — it
# creates /etc/echo-station.env from this file only when that path does not exist).
#
#   sudo cp /path/to/ECHO-rpi/echo-station.env.example /etc/echo-station.env
#   sudo nano /etc/echo-station.env
#   sudo chmod 600 /etc/echo-station.env
#   sudo systemctl restart echo-station.service

# Required for cloud ingest (omit both to keep CSV-only mode)
ECHO_APP_URL=https://your-app.vercel.app
ECHO_INGEST_SECRET=replace-with-same-value-as-vercel-INGEST_SECRET

# Optional (defaults shown in echo_station/config.py)
# ECHO_SOUND_PROFILE_ID=ambient3_meditation_v1
# ECHO_INGEST_TIMEOUT_SEC=60

# Daily sound render/playback (local Raspberry Pi)
# ECHO_DAILY_SOUND_ENABLED=true
# ECHO_DAILY_SOUND_AUTOPLAY=true
# ECHO_DAILY_SOUND_DURATION_SEC=45
# Optional explicit player command. Leave empty to try paplay, then pw-play, then aplay.
# ECHO_SOUND_PLAY_COMMAND=paplay {path}

# Browser playback server
# ECHO_DAILY_SOUND_WEB_ENABLED=true
# ECHO_SOUND_WEB_HOST=0.0.0.0
# ECHO_SOUND_WEB_PORT=8765
